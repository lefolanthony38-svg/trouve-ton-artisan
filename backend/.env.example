## Configuration de la base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trouve_ton_artisan
DB_USER=root
DB_PASSWORD= confidential

# Port de l'API
PORT=3000

# Envoi des emails (Ethereal = fausse boite mail de test, rien n'arrive aux vrais destinataires)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER= confidential
SMTP_PASS= confidential

# Adresse du site React autorisé à appeler l'API
FRONT_URL=http://localhost:5173

# Clé secrète que le site React doit envoyer pour utiliser l'API
API_KEY= confidential